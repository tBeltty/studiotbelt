# ==============================================================================
# tBelt Studio Configuration Template
# Copy to .env: cp .env.example .env
# ==============================================================================

# Active Generative Provider (fal, enhancor, or replicate)
# If left blank, automatically detects your configured key or select via UI Settings
ACTIVE_PROVIDER=

# Generative Provider API Credentials (Configure at least one)
FAL_KEY=
ENHANCOR_API_KEY=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
ENHANCOR_WEBHOOK_URL=
REPLICATE_API_TOKEN=
HF_TOKEN=
COMFY_URL=http://127.0.0.1:8188

# Media Host (Only needed if using external webhook callbacks)
MEDIA_HOST=tmpfiles
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=

# Server & Concurrency (Optional overrides)
# HOST=127.0.0.1
# PORT=8770
# STUDIO_MAX_WORKERS=2

# Video & Audio Processing (Optional overrides)
# TARGET_FPS=24
# MAX_WIDTH=1280
# PITCH_SEMITONES=3
# FFMPEG_CRF=18
# FFMPEG_PRESET=slow
# AUDIO_BITRATE=192000
# AUDIO_SAMPLE_RATE=44100

# Model Overrides & Spaces (Optional overrides)
# FAL_MODEL=minimax/h3-max/recast
# FAL_DEPTH_MODEL=fal-ai/depth-anything-video
# FAL_DEPTH_SIZE=original
# FAL_SAM_MODEL=fal-ai/sam-3/video
# FAL_RECAST_RESOLUTION=1080P
# FAL_WAN_RESOLUTION=720p
# FAL_HD_RESOLUTION=1080P
# REPLICATE_MODEL=fofr/live-portrait
# REPLICATE_DEPTH_MODEL=lucataco/depth-anything-video
# DEMUCS_MODEL=htdemucs
